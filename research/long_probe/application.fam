    fap_icon="retekess_demod_probe.png",  # 10x10 1-bit PNG
    fap_description="Read-only long CC1101 bit sampling experiment",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/retekess_demod_probe",
    fap_icon_assets="images",  # Image assets to compile for this application
)
