App(
    appid="retekess_rssi_probe",  # Must be unique
    name="Retekess RSSI Probe",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="retekess_rssi_probe_app",
    stack_size=4 * 1024,
    fap_category="Sub-GHz",
    # Optional values
    # fap_version="0.1",
    fap_icon="retekess_rssi_probe.png",  # 10x10 1-bit PNG
    fap_description="Read-only RSSI sweep for protocol research",
    # fap_author="J. Doe",
    # fap_weburl="https://github.com/user/retekess_rssi_probe",
    fap_icon_assets="images",  # Image assets to compile for this application
)
